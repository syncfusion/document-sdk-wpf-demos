<democommon:DemoControl
    x:Class="syncfusion.dociodemos.wpf.DigitalSignatureValidation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"
    mc:Ignorable="d">

    <Grid Margin="10">

        <StackPanel>

            <TextBlock
                Margin="0,0,0,10"
                FontSize="12"
                TextWrapping="Wrap">
                Click the button to validate the digital signature using the .NET Word (DocIO) Library.
            </TextBlock>

            <GroupBox Header="Digital Signature Validation">

                <StackPanel Margin="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Select Document :" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">

                            <Button Content="Choose File"
                                    Width="120"
                                    Click="btnBrowseDocument_Click"/>

                            <TextBlock x:Name="txtDocument"
                                       Margin="10,5,0,0"
                                       Text="No file chosen"/>
                        </StackPanel>

                    </Grid>

                    <Button Margin="0,15,0,0"
                            Width="170"
                            Height="30"
                            HorizontalAlignment="Left"
                            Click="btnValidate_Click">
                        Validate Signature
                    </Button>

                </StackPanel>

            </GroupBox>

            <TextBox x:Name="txtValidationResult"
                     Margin="0,15,0,0"
                     Height="250"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>

        </StackPanel>

    </Grid>

</democommon:DemoControl>