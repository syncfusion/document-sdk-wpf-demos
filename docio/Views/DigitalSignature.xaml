<democommon:DemoControl
    x:Class="syncfusion.dociodemos.wpf.DigitalSignature"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"
    mc:Ignorable="d">

    <Grid Margin="10">

        <StackPanel>

            <TextBlock
                TextWrapping="Wrap"
                Margin="0,0,0,10"
                FontSize="12">
                Click the button to create and digitally sign a Word document using the .NET Word (DocIO) Library.
                Please note that a valid certificate is required to digitally sign the generated document.
            </TextBlock>

            <!-- Signature Settings -->

            <GroupBox Header="Signature Settings">

                <StackPanel Margin="10">

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Width="150"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="Signature Standard :" />

                        <RadioButton x:Name="radioXmlDsig"
                                     Content="XML-DSig"
                                     IsChecked="True"
                                     Margin="10,0,20,0"/>

                        <RadioButton x:Name="radioXades"
                                     Content="XAdES"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">

                        <TextBlock Width="150"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="Signature Type :" />

                        <RadioButton x:Name="radioVisible"
                                     Content="Visible"
                                     IsChecked="True"
                                     Margin="10,0,20,0"/>

                        <RadioButton x:Name="radioInvisible"
                                     Content="Invisible"/>
                    </StackPanel>

                </StackPanel>

            </GroupBox>

            <!-- Create New -->

            <GroupBox Header="Sign new Word document"
                      Margin="0,15,0,0">

                <StackPanel Margin="10">

                    <TextBlock Margin="0,0,0,10">
                        Create a new Word document and digitally sign it using the selected signature settings.
                    </TextBlock>

                    <Button x:Name="btnCreate"
                            Width="220"
                            Height="30"
                            HorizontalAlignment="Left"
                            Click="btnCreate_Click">
                        Create and Sign Word Document
                    </Button>

                </StackPanel>

            </GroupBox>

            <!-- Existing -->

            <GroupBox Header="Sign existing Word document"
                      Margin="0,15,0,0">

                <Grid Margin="10,10,-2,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Margin="0,5"
                               Text="Source"/>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal">

                        <Button Content="Choose File"
                                Width="120"
                                Click="btnBrowseDocument_Click"/>

                        <TextBlock x:Name="txtDocument"
                                   Margin="10,5,0,0"
                                   Text="No file chosen"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
           Grid.Column="0"
           Margin="0,15,0,0"
           Text="Signature Image">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=radioVisible}"
                             Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>

                    </TextBlock>
                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=radioVisible}"
                             Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button Content="Choose Image"
                                Width="120"
                                Click="btnBrowseImage_Click"/>

                        <TextBlock x:Name="txtImage"
                                   Margin="10,5,0,0"
                                   Text="No file chosen"/>

                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Margin="0,15,0,0"
                               Text="Certificate"/>

                    <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,10,0,0"
                                Orientation="Horizontal">

                        <Button Content="Choose Certificate"
                                Width="140"
                                Click="btnBrowseCertificate_Click"/>

                        <TextBlock x:Name="txtCertificate"
                                   Margin="10,5,0,0"
                                   Text="No file chosen"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Margin="0,15,0,0"
                               Text="Password"/>

                    <PasswordBox x:Name="passwordBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Width="300"
                                 Margin="0,10,0,0"
                                 HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Margin="0,15,0,0"
                               Text="Comment"/>

                    <TextBox x:Name="txtComment"
                             Grid.Row="4"
                             Grid.Column="1"
                             Width="300"
                             Margin="0,10,0,0"
                             HorizontalAlignment="Left"/>
                    <Button x:Name="btn_Create" Grid.Row="5"
                            Margin="0,10,0,0"
                            Width="220"
                            Height="30"
                            HorizontalAlignment="Left"
                            Click="btnSign_Click" Grid.ColumnSpan="2">
                        Sign Word Document
                    </Button>


                </Grid>

            </GroupBox>

        </StackPanel>

    </Grid>

</democommon:DemoControl>